{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Project",
			"type": "shell",
			"command": "cmake",
			"args": ["--build", "Build"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"detail": "Build the current project using CMake"
		},
		{
			"label": "Clean Project",
			"type": "shell",
			"command": "cmake",
			"args": ["--build", "Build", "--target", "clean_all"],
			"group": "build",
			"problemMatcher": [],
			"detail": "Clean the build directory"
		}
	]
}